# Database
DATABASE_URL=postgres://scribble:scribble@localhost:5432/scribble

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=3000
CORS_ORIGIN=http://localhost:3001
API_BASE_URL=http://localhost:3000

# Auth - Social OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage (local or s3)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads

# S3 / MinIO (when STORAGE_PROVIDER=s3)
S3_BUCKET=scribble
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=scribble
S3_SECRET_ACCESS_KEY=scribble
S3_ENDPOINT=http://localhost:9000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3000
