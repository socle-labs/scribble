{
	"name": "scribble",
	"private": true,
	"packageManager": "bun@1.3.10",
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"dev": "turbo dev",
		"dev:infra": "docker compose -f docker-compose.dev.yml up -d",
		"build": "turbo build",
		"test": "turbo test",
		"lint": "turbo lint",
		"typecheck": "turbo typecheck",
		"db:migrate": "bun run --filter @scribble/db migrate",
		"db:generate": "bun run --filter @scribble/db generate",
		"db:studio": "bun run --filter @scribble/db studio",
		"format": "biome format --write .",
		"check": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"bun-types": "^1.3.10",
		"turbo": "^2.3.0",
		"typescript": "^5.7.0"
	}
}
